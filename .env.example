# Dabba Bela — environment variables. Copy to .env for local development.
# Never commit real secrets. Production values live in Vercel → Project → Settings → Environment Variables.

# ── Database (Neon Postgres, Singapore region) ───────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"          # pooled, used at runtime
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require" # direct, used by prisma migrate
# Local tests only: a throwaway database whose name contains "test" (each run uses its own schema)
DATABASE_URL_TEST="postgresql://user@localhost:5432/dabbabela_test?schema=public"

# ── Auth (Better Auth) ───────────────────────────────────────────
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"   # REQUIRED in production
BETTER_AUTH_URL="http://localhost:3100"                       # public origin of the app
AUTH_TRUSTED_ORIGINS=""                                       # extra comma-separated origins (e.g. preview domain)
AUTH_RATE_LIMIT=""                                            # "true" to enable auth rate limits outside production
# Development only — production always enforces TOTP for staff when the staff2fa flag is on
DISABLE_STAFF_2FA="true"

NEXT_PUBLIC_SITE_URL="http://localhost:3100"

# ── First owner + seed ───────────────────────────────────────────
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="change-me-to-a-long-password"
SEED_ADMIN_NAME="Owner"
SEED_DEMO="false"         # "true" adds demo staff/company/customers — NEVER in production
SETUP_KEY=""              # long random string for the one-time /setup screen in production

# ── Media uploads (Vercel Blob) — added automatically when you create a Blob store
BLOB_READ_WRITE_TOKEN=""

# ── Payments ─────────────────────────────────────────────────────
# eSewa ePay v2. Left empty outside production, the public eSewa sandbox credentials are used.
ESEWA_PRODUCT_CODE=""
ESEWA_SECRET_KEY=""
ESEWA_FORM_URL="https://rc-epay.esewa.com.np/api/epay/main/v2/form"        # live: https://epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL="https://rc.esewa.com.np/api/epay/transaction/status/"    # live: https://epay.esewa.com.np/api/epay/transaction/status/
# Khalti ePayment. Khalti stays hidden at checkout until a key is set.
KHALTI_SECRET_KEY=""
KHALTI_BASE_URL="https://dev.khalti.com/api/v2"                            # live: https://khalti.com/api/v2
PAYMENTS_SANDBOX=""       # "true" lets a production build use sandbox eSewa (staging only)

# ── Notifications ────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Dabba Bela <hello@your-domain.com.np>"
SMS_PROVIDER=""           # sparrow | aakash | console (console = dev only, prints OTPs)
SPARROW_TOKEN=""
SPARROW_FROM=""           # approved sender ID
AAKASH_TOKEN=""

# ── Cron (Vercel sends this as a Bearer token) ───────────────────
CRON_SECRET=""
